    "architecture": {
      "title": "Architecture",
      "source": {
        "label": "One source, three targets",
        "body": "Each problem is a single YYYYMMDD.tex file with its metadata declared inline as key/value pairs. The same source renders three ways: a standalone PDF, a booklet PDF, and this website."
      },
      "build": {
        "label": "Static build",
        "body": "A Vue 3 app compiled ahead of time. The build precompiles markdown content to HTML, prerenders every route to dist/<route>/index.html, and emits an llms.txt index — no runtime server."
      },
      "data": {
        "label": "Data flow",
        "body": "Problem metadata is bundled into the client at compile time (import.meta.glob); only the PDFs are fetched lazily from /data/{id}/."
      }
    },
