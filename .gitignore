# macOS
.DS_Store

# LaTeX build artifacts
*.aux
*.log
*.out
*.qps
*.toc
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.synctex.gz
*.synctex.gz(busy)

# Root-level compiled PDFs (booklet, single problems) — keep out of git.
*.pdf
# ...but the pre-compiled web export PDFs ARE committed (consumed by CI).
!web/**/*.pdf

# Local-only generated output
export/
.qpd-web-hashes.json
